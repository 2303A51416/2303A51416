# stage3_queries.py
from sqlalchemy import desc
from Stage2 import Notification, session


def get_unread_notifications(student_id: int, limit: int = 20):
    return (
        session.query(Notification)
        .filter(Notification.studentID == student_id, Notification.isRead.is_(False))
        .order_by(desc(Notification.createdAt))
        .limit(limit)  # pagination support
        .all()
    )

# Example usage
notifications = get_unread_notifications(1042)
for n in notifications:
    print(f"{n.createdAt} - {n.message}")
